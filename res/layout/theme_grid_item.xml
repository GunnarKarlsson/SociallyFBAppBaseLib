<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical" 
    android:background="@drawable/item_frame">

    <ImageView
        android:id="@+id/themeBackground"
        android:layout_width="100dip"
        android:layout_height="100dip"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
         />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal" >

        <ImageView
            android:id="@+id/themeActionBarColor"
            android:layout_width="45dip"
            android:layout_height="20dip"
            android:contentDescription="@null"
            android:scaleType="center" />

        <ImageView
            android:id="@+id/themeMenuColor"
            android:layout_width="45dip"
            android:layout_height="20dip"
            android:contentDescription="@null"
            android:scaleType="centerInside" />
    </LinearLayout>

    <TextView
        android:id="@+id/themeName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/smallGreyTextStyle" />

    <TextView
        android:id="@+id/themeAvailability"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/free"
        android:textAppearance="@style/smallGreyTextStyle" />
    
    <ImageView 
        android:id="@+id/imageStorage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        />

</LinearLayout>