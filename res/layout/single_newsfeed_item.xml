<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/square_white" >

    <include
        android:id="@+id/fromHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        layout="@layout/from_header" />

    <TextView
        android:id="@+id/newsFeedItemMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/fromHeader"
        android:paddingLeft="10dip"
        android:singleLine="false"
        android:paddingRight="10dip"
        android:paddingTop="10dip"
        android:textAppearance="@style/smallHeadLineTextStyle" />

    <LinearLayout
        android:id="@+id/newsFeedItemPictureAndName"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/newsFeedItemMessage"
        android:background="#efefef"
        android:orientation="horizontal"
        android:paddingBottom="10dip"
        android:paddingLeft="10dip"
        android:paddingRight="10dip"
        android:paddingTop="10dip" >

        <com.bluebitapps.utils.AspectRatioImageView
            android:id="@+id/newsFeedItemPicture"
            android:layout_width="80dip"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true" />

        <TextView
            android:id="@+id/newsFeedItemName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="5dip"
            android:paddingTop="0dip"
            android:singleLine="false"
            android:textAppearance="@style/bodyTextStyle" />
    </LinearLayout>

    <TextView
        android:id="@+id/newsFeedItemDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/newsFeedItemPictureAndName"
        android:singleLine="false"
        android:paddingBottom="0dip"
        android:paddingLeft="10dip"
        android:paddingRight="10dip"
        android:paddingTop="5dip"
        android:textAppearance="@style/bodyTextStyle" />

    <include
        android:id="@+id/likeSection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/newsFeedItemDescription"
        android:layout_alignParentRight="true"
        android:padding="10dip"
        layout="@layout/action_footer_like_big" />

</RelativeLayout>