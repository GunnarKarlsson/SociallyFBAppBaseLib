<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    style="@android:style/Theme.Holo.Light"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    android:padding="10dip" 
    android:clipToPadding="false">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent" >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/square_white_four_borders"
            android:orientation="vertical"
            android:padding="10dip" 
            android:clipToPadding="false">

            <com.bluebitapps.utils.AspectRatioImageView
                android:id="@+id/image"
                android:layout_width="68dip"
                android:layout_height="wrap_content"
                android:contentDescription="@null"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Caption"
                android:textColor="#000000"
                android:textSize="20dip" />

            <EditText
                android:id="@+id/message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/edit_text_holo_light"
                android:cursorVisible="true"
                android:gravity="top"
                android:textColor="#000000"
                android:textSize="16dip" />

                     <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="20dip"
                android:text="Album"
                android:textColor="#000000"
                android:textSize="20dip" />
                     
                      

            <Spinner
                android:id="@+id/albumSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            
              <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dip"
                android:text="Note that if you don't use Mobile Uploads as album, you may have to approve the upload on the Facebook website before the photo is visible in the album."
                android:textColor="#000000"
                android:textSize="10dip" />
            
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="20dip"
                android:text="Privacy"
                android:textColor="#000000"
                android:textSize="20dip" />

            <Spinner
                android:id="@+id/privacySpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entries="@array/privacy_for_post_array"
                android:prompt="@string/privacy_spinner_prompt" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>