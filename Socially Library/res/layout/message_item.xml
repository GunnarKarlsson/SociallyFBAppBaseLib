<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/item_frame">

    <ImageView
        android:id="@+id/messageFromPicture"
        android:layout_width="64dip"
        android:layout_height="64dip"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:paddingLeft="10dip"
        android:paddingTop="10dip" 
        android:contentDescription="@null"/>

    <TextView
        android:id="@+id/messageFromName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@id/messageFromPicture"
        android:paddingLeft="5dip"
        android:paddingRight="5dip"
        android:paddingTop="12dip" />

    <ImageView
        android:id="@+id/messageCreatedTimeImage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/messageFromName"
        android:layout_toRightOf="@id/messageFromPicture"
        android:paddingBottom="5dip"
        android:paddingLeft="5dip"
        android:paddingRight="2dip"
        android:paddingTop="3dip"
        android:src="@drawable/clock" 
        android:contentDescription="@null"/>

    <TextView
        android:id="@+id/messageCreatedTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/messageFromName"
        android:layout_toRightOf="@id/messageCreatedTimeImage"
        android:paddingBottom="5dp"
        android:paddingTop="3dp"
        android:textAppearance="@style/smallGreyTextStyle" />

    <TextView
        android:id="@+id/messageText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/messageCreatedTime"
        android:paddingLeft="20dip"
        android:paddingRight="20dip"
        android:paddingTop="20dip" 
        android:paddingBottom="20dip"/>
  

</RelativeLayout>