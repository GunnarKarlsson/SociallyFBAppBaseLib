<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/square_white" >

    <include
        android:id="@+id/fromHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        layout="@layout/from_header" />
    

    <TextView
        android:id="@+id/newsFeedItemMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/fromHeader"
        android:singleLine="false"
        android:paddingLeft="10dip"
        android:paddingRight="10dip"
        android:paddingTop="10dip"
        android:textAppearance="@style/smallHeadLineTextStyle" />

    <LinearLayout
        android:id="@+id/newsFeedItemPictureAndName"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/newsFeedItemMessage"
        android:orientation="vertical"
        android:paddingLeft="10dip"
        android:paddingRight="10dip" 
        android:paddingTop="20dp"
        android:paddingBottom="8dip">

        <RelativeLayout
            android:id="@+id/photoSection"
            xmlns:android="http://schemas.android.com/apk/res/android"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent" 
            android:padding="0.5dip"
            android:background="@drawable/square_shape_grey_border">

            <ProgressBar
                android:id="@+id/newsFeedItemPictureProgressBar"
                android:layout_width="15dip"
                android:layout_height="15dip"
                android:layout_centerInParent="true" />

            <com.bluebitapps.utils.AspectRatioImageView
                android:id="@+id/newsFeedItemImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:adjustViewBounds="true" />
        </RelativeLayout>

    </LinearLayout>
    
            <TextView
            android:id="@+id/newsFeedItemName"
            android:layout_below="@id/newsFeedItemPictureAndName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="10dip"
            android:paddingRight="10dip"
            android:paddingTop="10dip"
            android:singleLine="false"
            android:textAppearance="@style/bodyTextStyle" />
  

    <TextView
        android:id="@+id/newsFeedItemDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/newsFeedItemName"
        android:singleLine="false"
        android:paddingBottom="0dip"
        android:paddingLeft="10dip"
        android:paddingRight="10dip"
        android:paddingTop="5dip"
        android:textAppearance="@style/bodyTextStyle" />

    <include
        android:id="@+id/likeSection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/newsFeedItemDescription"
        android:layout_alignParentRight="true"
        android:padding="10dip"
        layout="@layout/action_footer_like_big" />

</RelativeLayout>