<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/square_white_four_borders"
    android:padding="10dip">

    <include
        android:id="@+id/fromHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        layout="@layout/from_header" />

    <TextView
        android:id="@+id/placeLabel"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/fromHeader"
        android:padding="5dip"
        android:text="checked in at" 
        android:textAppearance="@style/bodyTextStyle"/>

    <TextView
        android:id="@+id/placeName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/placeLabel"
        android:paddingLeft="5dip"
        android:paddingRight="10dip"
        android:textAppearance="@style/bodyTextStyle" />

    <TextView
        android:id="@+id/locationName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/placeName"
        android:paddingBottom="0dp"
        android:paddingLeft="2dip"
        android:paddingRight="10dip"
        android:paddingTop="2dp"
        android:textAppearance="@style/smallGreyTextStyle" />
    
        <TextView
        android:id="@+id/message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/locationName"
        android:paddingBottom="0dp"
        android:paddingLeft="2dip"
        android:paddingRight="10dip"
        android:paddingTop="2dp"
        android:textAppearance="@style/smallGreyTextStyle" />

</RelativeLayout>