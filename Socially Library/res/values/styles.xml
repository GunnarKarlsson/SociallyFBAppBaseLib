<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <style name="ThemeHoloWithActionBarShadow" parent="android:Theme.Holo">
        <item name="android:windowContentOverlay">@drawable/actionbar_shadow</item>
        <item name="android:actionBarTabStyle">@style/ActionBarTabStyle</item>
        <item name="android:actionBarStyle">@style/ActionBarStyle</item>
        <item name="android:spinnerStyle">@style/SpinnerStyle</item>
        <item name="android:spinnerItemStyle">@style/TextAppearanceSpinnerItem</item>
        <item name="android:spinnerDropDownItemStyle">@style/SpinnerDropDownItem</item>
    </style>

    <style name="ActionBarStyle" parent="android:style/Widget.Holo.ActionBar">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:subtitleTextStyle">@style/SubtitleTextStyle</item>
    </style>

    <style name="SubtitleTextStyle" parent="android:TextAppearance.Holo.Widget.ActionBar.Subtitle">
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="ActionBarTabStyle" parent="@android:style/Widget.Holo.ActionBar.TabView">
        <item name="android:background">@drawable/actionbar_tab_indicator</item>
    </style>

    <style name="small_text">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/blackColor</item>
    </style>

    <style name="medium_text">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/blackColor</item>
    </style>

    <style name="large_text">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/blackColor</item>
    </style>

    <style name="ThemeHoloWithActionBarShadow.SmallText">
        <item name="smallText">@style/small_text</item>
    </style>

    <style name="ThemeHoloWithActionBarShadow.MediumText">
        <item name="mediumText">@style/medium_text</item>
    </style>

    <style name="ThemeHoloWithActionBarShadow.LargeText">
        <item name="largeText">@style/large_text</item>
    </style>

    <style name="NotificationAlertStyle" parent="@android:style/Theme.Holo.Light.Dialog.NoActionBar">
        <item name="android:windowBackground">@drawable/square_white_four_borders</item>
    </style>

    <style name="SpinnerStyle" parent="@android:style/Widget.Holo.Light.Spinner">
        <item name="android:clickable">true</item>
    </style>

    <style name="TextAppearanceSpinnerItem" parent="android:style/TextAppearance.Holo.Widget.TextView.SpinnerItem">
        <item name="android:textColor">#666666</item>
    </style>

    <style name="SpinnerDropDownItem" parent="android:style/Widget.Holo.Light.DropDownItem.Spinner">
        <item name="android:textColor">#222222</item>
    </style>

    <style name="ButtonStyleSmall" parent="android:style/Widget.Button">
        <item name="android:background">@drawable/custom_button</item>
        <item name="android:textColor">#222222</item>
        <item name="android:textSize">12sp</item>
        <item name="android:padding">6dip</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">28dip</item>
    </style>

        <style name="ButtonStyleLarge" parent="android:style/Widget.Button">
        <item name="android:background">@drawable/custom_button</item>
        <item name="android:textColor">#222222</item>
        <item name="android:textSize">16sp</item>
        <item name="android:padding">6dip</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dip</item>
    </style>
    
</resources>